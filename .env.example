APP_NAME="Bantu Daftarin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Production acceptance requires APP_ENV=production, APP_DEBUG=false, and an
# HTTPS APP_URL. Verify the effective values with security:check-production.

APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is the local application database. Leave DB_URL unset unless it
# contains an equivalent PostgreSQL connection URL.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bantu_daftarin_mvp
DB_USERNAME=bantu_daftarin_app
DB_PASSWORD=
DB_SCHEMA=public
DB_CHARSET=utf8
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Set SESSION_SECURE_COOKIE=true in production. When omitted, Laravel enables
# it automatically for APP_ENV=production; an explicit false value is unsafe.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Development only. Production must use an authenticated delivery transport;
# security:check-production rejects log/array and unsafe failover transports.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

XENDIT_DRIVER=xendit
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_INVOICE_DURATION=86400

MALWARE_SCAN_DRIVER=clamav
CLAMAV_BINARY=clamdscan
CLAMAV_SIGNATURE_MAX_AGE_HOURS=48
DOCUMENT_RETENTION_DAYS=
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

ADMIN_EMAIL=admin@example.test
ADMIN_NAME="Super Admin"
ADMIN_SEED_PASSWORD=
NPWP_PERSONAL_PRICE=150000
NPWP_BUSINESS_PRICE=500000
